{
  "name": "chat-adapter-twilio",
  "version": "0.1.1",
  "description": "Twilio SMS adapter for the Vercel Chat SDK.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "chat-sdk",
    "chat-adapter",
    "twilio",
    "sms",
    "bot"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/delphi-ai/chat-adapter-twilio.git"
  },
  "bugs": {
    "url": "https://github.com/delphi-ai/chat-adapter-twilio/issues"
  },
  "homepage": "https://github.com/delphi-ai/chat-adapter-twilio#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "chat": "^4.0.0"
  },
  "dependencies": {
    "@chat-adapter/shared": "^4.27.0",
    "twilio": "^6.0.0"
  },
  "devDependencies": {
    "@chat-adapter/state-memory": "^4.27.0",
    "@types/node": "^25.6.0",
    "chat": "^4.27.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
